---
import { Countdown } from "./Countdown";
import SandClock from "./icons/SandClock.astro"
---

<section id="cuenta-regresiva" class="grid place-items-center py-32">
    <div class="flex flex-col gap-y-12">
        <div>
            <SandClock />
        </div>
        <div class="flex flex-col items-center">
            <p class="font-body tracking-[0.2rem] text-petroleum text-sm">FALTA CADA VEZ MENOS</p>
            <h2 class="font-title text-5xl text-charcoal text-center">Cuenta Regresiva</h2>
        </div>
        <div class="flex justify-between gap-x-8 lg:gap-x-24">
            <Countdown client:load />
        </div>
    </div>
</section>