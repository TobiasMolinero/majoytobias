            <h2 class="font-title text-parchment text-3xl"><i>Nos casamos</i></h2>
            <div class="h-[0.5px] w-8 sm:w-12 bg-earth/60"></div>
        </div>
        <div class="flex flex-col justify-center items-center gap-y-2">
