            <p class="font-body tracking-[0.2rem] text-parchment text-sm">YERBA BUENA - TUCUMÁN</p>
        </div>
    </div>
    
    <div class="background-overlay absolute top-0 left-0 w-full h-full bg-black/40"></div>
